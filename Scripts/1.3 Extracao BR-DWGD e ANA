# ============================================================
# Extração BR-DWGD e ANA  -  Taquari / RS
# Script independente. Não junta com CHIRPS/NASA POWER ainda.
# Grava em saidas/diario/ no mesmo schema: data | prec
# ============================================================

library(sf)
library(dplyr)
library(lubridate)

INICIO <- as.Date("1981-01-01")
FIM    <- as.Date("2025-12-31")

COD_IBGE <- 4321303          # Taquari/RS  (Taquara e 4321204, nao confundir)

dir.create("saidas/diario", showWarnings = FALSE, recursive = TRUE)

# centroide: reaproveita se ja existir, senao recalcula
if (file.exists("saidas/local_taquari.rds")) {
  loc <- readRDS("saidas/local_taquari.rds")
  LON <- loc$lon; LAT <- loc$lat; taquari <- loc$geom
} else {
  library(geobr)
  mun_rs  <- read_municipality(code_muni = "RS", year = 2020)
  taquari <- mun_rs %>% filter(code_muni == COD_IBGE)
  stopifnot(nrow(taquari) == 1)
  loc <- suppressWarnings(st_centroid(taquari))
  xy  <- st_coordinates(loc)
  LON <- xy[1, "X"]; LAT <- xy[1, "Y"]
}
centro <- suppressWarnings(st_centroid(taquari))

cat(sprintf("Taquari/RS | lon %.5f | lat %.5f\n\n", LON, LAT))

gravar_diario <- function(df, fonte) {
  out <- df %>%
    filter(data >= INICIO, data <= FIM) %>%
    transmute(data = as.Date(data), prec = as.numeric(prec)) %>%
    mutate(prec = ifelse(prec < 0, NA_real_, prec)) %>%
    distinct(data, .keep_all = TRUE) %>%
    arrange(data)
  write.csv(out, file.path("saidas/diario", paste0(fonte, ".csv")),
            row.names = FALSE)
  cat(sprintf("\n%-10s %5d dias | %s a %s | %d faltantes\n",
              fonte, nrow(out), min(out$data), max(out$data),
              sum(is.na(out$prec))))
  invisible(out)
}


# ############################################################
# PARTE A - BR-DWGD via brclimr
# ############################################################
#
# CORREÇÃO: a função é fetch_data(), não zonal_data().
# Foi por isso que falhou em silêncio no script anterior.
#
# install.packages("brclimr")   # esta no CRAN

library(brclimr)

# 1) descobrir indicadores e estatisticas disponiveis
product_info("brdwgd")
# precipitacao = "pr"
# rode e confira quais statistics existem: mean, max, min, sd, sum...


# 2) extrair
# "max" = maior valor entre as celulas que intersectam o municipio
# "mean" = media das celulas. Para comparar com CHIRPS (celula unica
# no centroide), "mean" e o mais proximo conceitualmente.
brdwgd_dia <- fetch_data(
  code_muni  = COD_IBGE,
  product    = "brdwgd",
  indicator  = "pr",
  statistics = "mean",
  date_start = INICIO,
  date_end   = FIM
) %>%
  transmute(data = as.Date(date), prec = value)

cat("BR-DWGD bruto:", nrow(brdwgd_dia), "linhas |",
    as.character(min(brdwgd_dia$data)), "a",
    as.character(max(brdwgd_dia$data)), "\n")

gravar_diario(brdwgd_dia, "BR_DWGD")

# >>> ATENÇÃO AO PERIODO <<<
# A versao do BR-DWGD servida pelo brclimr cobre 1961-01-01 a 2020-07-31.
# Se o max(data) acima for 2020-07-31, o brclimr NAO chega a 2025.
# Nesse caso, ou voce aceita a serie mais curta, ou usa a Parte A2.


# ------------------------------------------------------------
# PARTE A2 - BR-DWGD completo via NetCDF (opcional)
# Use so se precisar chegar ate 2025.
# Baixe os .nc de precipitacao do site do Xavier (v3.2.4) e
# aponte o caminho abaixo. Requer ~6 GB de RAM livre.
# ------------------------------------------------------------

if (FALSE) {
  library(terra)

  arquivos_nc <- list.files("brdwgd_nc", pattern = "\\.nc$", full.names = TRUE)

  pt <- vect(data.frame(lon = LON, lat = LAT),
             geom = c("lon", "lat"), crs = "EPSG:4326")

  extrair_nc <- function(f) {
    r <- rast(f)
    v <- as.numeric(terra::extract(r, pt)[1, -1])
    data.frame(data = as.Date(time(r)), prec = v)
  }

  brdwgd_dia <- bind_rows(lapply(arquivos_nc, extrair_nc)) %>% arrange(data)
  gravar_diario(brdwgd_dia, "BR_DWGD")
}


# ############################################################
# PARTE B - ANA / HidroWeb via hydrobr
# ############################################################
#
# CORREÇÃO: o pacote nao esta no CRAN e a funcao de inventario
# se chama inventory(), nao stationsInventory().
#
# remotes::install_github("hydroversebr/hydrobr")

library(hydrobr)

# se ainda der erro de funcao, descubra os nomes reais:
# ls("package:hydrobr")


# ---- B1. Inventário de postos pluviométricos no RS ----

inv <- inventory(
  states      = "RIO GRANDE DO SUL",
  stationType = "plu",
  as_sf       = TRUE,
  aoi         = NULL
)

cat("\nPostos pluviometricos no RS:", nrow(inv), "\n")


# ---- B2. Postos próximos de Taquari ----

inv_perto <- inv %>%
  mutate(dist_km = as.numeric(st_distance(., centro)) / 1000) %>%
  filter(dist_km <= 50) %>%
  arrange(dist_km)

# nomes de coluna variam entre versoes: veja o que existe
cat("\nColunas do inventario:\n"); print(names(inv))

cat("\n--- Postos ate 50 km do centroide ---\n")
print(as.data.frame(inv_perto) %>% select(-any_of("geometry")) %>% head(20))


# >>> ESCOLHA O POSTO OLHANDO: <<<
#   - periodo de operacao cobrindo 1981-2025
#   - baixa taxa de falhas
#   - proximidade e criterio secundario, nao principal

CODIGO_ANA <- NA    # <-- preencha aqui


# ---- B3. Baixar a série do posto escolhido ----

if (!is.na(CODIGO_ANA)) {

  dados_brutos <- stationsData(
    inventoryResult   = inv %>% filter(station_code == CODIGO_ANA),
    deleteNAstations  = FALSE
  )

  organizados <- organize(dados_brutos)

  ana_dia <- organizados[[1]] %>%
    transmute(data = as.Date(date), prec = as.numeric(value)) %>%
    arrange(data)

  gravar_diario(ana_dia, "ANA")

  # diagnostico de falhas por ano: decisivo para julgar o posto
  cat("\nFalhas por ano:\n")
  ana_dia %>%
    filter(data >= INICIO, data <= FIM) %>%
    mutate(ano = year(data)) %>%
    group_by(ano) %>%
    summarise(dias = n(), faltantes = sum(is.na(prec)),
              pct_falha = round(100 * faltantes / dias, 1)) %>%
    as.data.frame() %>% print()

} else {
  message(">> Preencha CODIGO_ANA com o posto escolhido e rode a Parte B3.")
}


# ------------------------------------------------------------
# PARTE B2 - ANA manual (alternativa ao pacote)
# Baixe a serie no portal HidroWeb, salve como CSV e rode:
# ------------------------------------------------------------

if (FALSE) {
  bruto <- read.csv2("entrada/ana_hidroweb.csv", skip = 12)  # ajuste o skip

  ana_dia <- bruto %>%
    transmute(data = as.Date(Data, format = "%d/%m/%Y"),
              prec = as.numeric(Total)) %>%
    arrange(data)

  gravar_diario(ana_dia, "ANA")
}


cat("\n=== Arquivos em saidas/diario/ ===\n")
print(list.files("saidas/diario"))
