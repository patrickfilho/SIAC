# ============================================================
# Extração de precipitação diária para Taquari / RS
# Quatro fontes: CHIRPS, BR-DWGD, NASA POWER, ANA
# Saída: séries diárias + máximos mensais + relatório de cobertura
# ============================================================
#
# ESTRUTURA
#   Bloco 0 - centroide de Taquari
#   Bloco 1 - CHIRPS        (automático)
#   Bloco 2 - NASA POWER    (automático)
#   Bloco 3 - BR-DWGD       (automático OU csv manual)
#   Bloco 4 - ANA/HidroWeb  (automático OU csv manual)
#   Bloco 5 - máximos mensais com regra de falhas
#   Bloco 6 - relatório de cobertura (início/fim de cada fonte)
#
# Rode bloco a bloco. Se um falhar, os outros seguem.
# ============================================================

# install.packages(c("geobr","sf","dplyr","tidyr","lubridate","chirps","nasapower"))

library(sf)
library(dplyr)
library(tidyr)
library(lubridate)

INICIO <- as.Date("1981-01-01")
FIM    <- as.Date("2025-02-28")

# máximo de dias faltantes tolerados num bloco mensal
MAX_FALHAS <- 3

dir.create("saidas", showWarnings = FALSE)


# ============================================================
# BLOCO 0 - Centroide de Taquari
# ============================================================

library(geobr)

mun_rs   <- read_municipality(code_muni = "RS", year = 2020)
taquari  <- mun_rs %>% filter(name_muni == "Taquari")

centro <- suppressWarnings(st_centroid(taquari))
xy  <- st_coordinates(centro)
LON <- xy[1, "X"]
LAT <- xy[1, "Y"]
COD_IBGE <- taquari$code_muni[1]

cat(sprintf("Taquari/RS | lon %.5f | lat %.5f | IBGE %s\n", LON, LAT, COD_IBGE))


# ============================================================
# BLOCO 1 - CHIRPS  (0.05 graus ~ 5,3 km | 1981-presente)
# ============================================================

chirps_dia <- NULL

try({
  library(chirps)

  ponto <- data.frame(lon = LON, lat = LAT)

  # a API recusa intervalos longos; quebramos ano a ano
  anos <- year(INICIO):year(FIM)

  lista <- lapply(anos, function(a) {
    ini <- max(as.Date(sprintf("%d-01-01", a)), INICIO)
    fim <- min(as.Date(sprintf("%d-12-31", a)), FIM)
    message("CHIRPS ", a)
    r <- try(get_chirps(ponto, dates = c(as.character(ini), as.character(fim)),
                        server = "CHC", as.matrix = FALSE), silent = TRUE)
    if (inherits(r, "try-error")) { warning("falhou em ", a); return(NULL) }
    r
  })

  chirps_dia <- bind_rows(lista[!sapply(lista, is.null)]) %>%
    transmute(data = as.Date(date), prec = chirps) %>%
    mutate(prec = ifelse(prec < 0, NA_real_, prec)) %>%   # -9999 = faltante
    arrange(data) %>%
    distinct(data, .keep_all = TRUE)

  cat("CHIRPS:", nrow(chirps_dia), "dias\n")
}, silent = FALSE)


# ============================================================
# BLOCO 2 - NASA POWER  (MERRA-2 | 1981-presente)
# Reanálise: precipitação simulada, não medida
# ============================================================

power_dia <- NULL

try({
  library(nasapower)

  power_dia <- get_power(
    community   = "ag",
    lonlat      = c(LON, LAT),
    pars        = "PRECTOTCORR",
    dates       = c(as.character(INICIO), as.character(FIM)),
    temporal_api = "daily"
  ) %>%
    as.data.frame() %>%
    transmute(data = as.Date(YYYYMMDD), prec = PRECTOTCORR) %>%
    mutate(prec = ifelse(prec < 0, NA_real_, prec)) %>%     # -999 = faltante
    arrange(data)

  cat("NASA POWER:", nrow(power_dia), "dias\n")
}, silent = FALSE)


# ============================================================
# BLOCO 3 - BR-DWGD  (0.1 grau | 1961-2025 na v3.2.4)
# ------------------------------------------------------------
# CAMINHO A: pacote brclimr (estatísticas zonais por município)
# CAMINHO B: csv baixado à mão do DataClimaBR
# Confira a assinatura de zonal_data() na documentação do pacote:
# os nomes dos argumentos mudaram entre versões.
# ============================================================

brdwgd_dia <- NULL

# --- Caminho A ---
try({
  library(brclimr)

  brdwgd_dia <- zonal_data(
    territory_id = as.numeric(COD_IBGE),
    product      = "brdwgd",
    statistics   = "max",        # "max" da célula no polígono; "mean" também serve
    date_start   = INICIO,
    date_end     = FIM
  ) %>%
    filter(name == "pr") %>%
    transmute(data = as.Date(date), prec = value) %>%
    arrange(data)

  cat("BR-DWGD (brclimr):", nrow(brdwgd_dia), "dias\n")
}, silent = TRUE)

# --- Caminho B: fallback manual ---
if (is.null(brdwgd_dia) && file.exists("entrada/brdwgd_taquari.csv")) {
  brdwgd_dia <- read.csv("entrada/brdwgd_taquari.csv") %>%
    transmute(data = as.Date(data), prec = as.numeric(prec)) %>%
    arrange(data)
  cat("BR-DWGD (csv manual):", nrow(brdwgd_dia), "dias\n")
}

if (is.null(brdwgd_dia)) {
  message(">> BR-DWGD nao obtido. Baixe pelo DataClimaBR e salve em ",
          "entrada/brdwgd_taquari.csv com colunas: data, prec")
}


# ============================================================
# BLOCO 4 - ANA / HidroWeb  (pluviômetro: medição direta)
# ------------------------------------------------------------
# ESCOLHA O POSTO À MÃO ANTES DE RODAR ISTO.
# Critérios: opera em 1981-2025, poucas falhas, sem mudança de local.
# O pacote hydrobr ajuda no inventário; a seleção é decisão sua.
# ============================================================

ana_dia <- NULL

# --- Caminho A: inventário via hydrobr ---
try({
  library(hydrobr)

  inv <- stationsInventory(
    states      = "RIO GRANDE DO SUL",
    stationType = "plu",
    as_sf       = TRUE
  )

  # postos num raio aproximado de 30 km do centroide
  inv_perto <- inv %>%
    mutate(dist_km = as.numeric(st_distance(., centro)) / 1000) %>%
    filter(dist_km <= 30) %>%
    arrange(dist_km)

  print(as.data.frame(inv_perto)[, c("station_code", "name", "dist_km")])
  message(">> Escolha um codigo acima e preencha CODIGO_ANA abaixo.")
}, silent = TRUE)

CODIGO_ANA <- NA   # <-- preencha com o codigo do posto escolhido

# --- Caminho B: csv exportado do portal HidroWeb ---
if (is.null(ana_dia) && file.exists("entrada/ana_taquari.csv")) {
  ana_dia <- read.csv("entrada/ana_taquari.csv") %>%
    transmute(data = as.Date(data), prec = as.numeric(prec)) %>%
    arrange(data)
  cat("ANA (csv manual):", nrow(ana_dia), "dias\n")
}

if (is.null(ana_dia)) {
  message(">> ANA nao obtido. Exporte do HidroWeb e salve em ",
          "entrada/ana_taquari.csv com colunas: data, prec")
}


# ============================================================
# BLOCO 5 - Máximos mensais
# ------------------------------------------------------------
# Regra de falhas: bloco com mais de MAX_FALHAS dias ausentes
# é descartado. Sem isso, meses incompletos entram com máximo
# artificialmente baixo e achatam a cauda da GEV.
# ============================================================

maximos_mensais <- function(df, fonte) {
  if (is.null(df) || nrow(df) == 0) return(NULL)

  df %>%
    filter(data >= INICIO, data <= FIM) %>%
    mutate(ano = year(data), mes = month(data)) %>%
    group_by(ano, mes) %>%
    summarise(
      dias_esperados = days_in_month(as.Date(sprintf("%d-%02d-01", first(ano), first(mes)))),
      dias_com_dado  = sum(!is.na(prec)),
      falhas         = dias_esperados - dias_com_dado,
      max_prec       = ifelse(dias_com_dado > 0, max(prec, na.rm = TRUE), NA_real_),
      data_do_max    = if (dias_com_dado > 0) data[which.max(replace(prec, is.na(prec), -Inf))] else as.Date(NA),
      .groups = "drop"
    ) %>%
    mutate(
      fonte   = fonte,
      valido  = falhas <= MAX_FALHAS & !is.na(max_prec),
      ano_mes = sprintf("%d-%02d", ano, mes)
    )
}

max_all <- bind_rows(
  maximos_mensais(chirps_dia, "CHIRPS"),
  maximos_mensais(power_dia,  "NASA_POWER"),
  maximos_mensais(brdwgd_dia, "BR_DWGD"),
  maximos_mensais(ana_dia,    "ANA")
)


# ============================================================
# BLOCO 6 - Relatório de cobertura
# Responde: qual mês/ano cada fonte começa e termina,
# quantos blocos válidos, e onde estão os buracos
# ============================================================

cobertura <- max_all %>%
  filter(valido) %>%
  group_by(fonte) %>%
  summarise(
    inicio          = min(ano_mes),
    fim             = max(ano_mes),
    blocos_validos  = n(),
    .groups = "drop"
  ) %>%
  left_join(
    max_all %>%
      group_by(fonte) %>%
      summarise(
        blocos_totais    = n(),
        blocos_perdidos  = sum(!valido),
        .groups = "drop"
      ),
    by = "fonte"
  ) %>%
  mutate(
    meses_no_intervalo = 530,   # jan/1981 a fev/2025
    cobertura_pct = round(100 * blocos_validos / meses_no_intervalo, 1)
  )

cat("\n================ COBERTURA POR FONTE ================\n")
print(as.data.frame(cobertura))

# meses descartados, para inspeção
descartados <- max_all %>%
  filter(!valido) %>%
  select(fonte, ano_mes, dias_com_dado, falhas, max_prec) %>%
  arrange(fonte, ano_mes)

cat("\nBlocos descartados:", nrow(descartados), "\n")
if (nrow(descartados) > 0) print(head(as.data.frame(descartados), 30))

# período em que TODAS as fontes disponíveis têm dado válido
comuns <- max_all %>%
  filter(valido) %>%
  count(ano_mes) %>%
  filter(n == n_distinct(max_all$fonte))

if (nrow(comuns) > 0) {
  cat(sprintf("\nPeriodo comum a todas as fontes: %s a %s (%d blocos)\n",
              min(comuns$ano_mes), max(comuns$ano_mes), nrow(comuns)))
}


# ============================================================
# SAÍDAS
# ============================================================

if (!is.null(chirps_dia)) write.csv(chirps_dia, "saidas/diario_chirps.csv", row.names = FALSE)
if (!is.null(power_dia))  write.csv(power_dia,  "saidas/diario_power.csv",  row.names = FALSE)
if (!is.null(brdwgd_dia)) write.csv(brdwgd_dia, "saidas/diario_brdwgd.csv", row.names = FALSE)
if (!is.null(ana_dia))    write.csv(ana_dia,    "saidas/diario_ana.csv",    row.names = FALSE)

write.csv(max_all,    "saidas/maximos_mensais_long.csv", row.names = FALSE)
write.csv(cobertura,  "saidas/cobertura.csv",            row.names = FALSE)

# formato largo, uma coluna por fonte - é este que voce me manda
max_wide <- max_all %>%
  filter(valido) %>%
  select(ano_mes, ano, mes, fonte, max_prec) %>%
  pivot_wider(names_from = fonte, values_from = max_prec) %>%
  arrange(ano_mes)

write.csv(max_wide, "saidas/maximos_mensais_wide.csv", row.names = FALSE)

cat("\nArquivos gravados em saidas/\n")
cat("Estatisticas dos maximos por fonte:\n")
print(summary(max_wide[, -(1:3)]))
