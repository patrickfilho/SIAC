# 23. Erros-padrão aproximados via Hessiana

```{r hessiana-funcoes}
# ============================================================
# 23. HESSIANA NUMERICA
# ============================================================

nll_sp_transf <- function(
    par,
    y,
    X,
    E,
    S,
    grid_idx,
    tipo
) {

  p <- ncol(X)

  beta <-
    par[
      1:p
    ]


  if (tipo == "global") {

    gamma_psi <-
      par[
        p + 1
      ]

    log_phi <-
      par[
        p + 2
      ]

  } else {

    G <- max(
      grid_idx
    )

    gamma_psi <-
      par[
        (p + 1):
          (p + G)
      ]

    log_phi <-
      par[
        p + G + 1
      ]

  }


  phi <-
    exp(
      log_phi
    )


  mu <- calcular_mu_spnb(

    beta =
      beta,

    gamma_psi =
      gamma_psi,

    X =
      X,

    E =
      E,

    S =
      S,

    grid_idx =
      grid_idx,

    tipo =
      tipo

  )


  -loglik_nb(
    y,
    mu,
    phi
  )
}


extrair_se_sp <- function(
    fit,
    y,
    X,
    E,
    S,
    grid_idx
) {

  p <- ncol(X)


  par_final <- c(

    fit$beta,

    fit$gamma_psi,

    log(
      fit$phi
    )

  )


  H <- optimHess(

    par =
      par_final,

    fn =
      nll_sp_transf,

    y =
      y,

    X =
      X,

    E =
      E,

    S =
      S,

    grid_idx =
      grid_idx,

    tipo =
      fit$tipo

  )


  V <- tryCatch(

    solve(H),

    error = function(e) {

      MASS::ginv(
        H
      )

    }

  )


  se_transf <-
    sqrt(
      pmax(
        diag(V),
        0
      )
    )


  se_beta <-
    se_transf[
      1:p
    ]


  n_psi <-
    length(
      fit$psi
    )


  se_gamma <-
    se_transf[
      (p + 1):
        (p + n_psi)
    ]


  # Delta method:
  # psi = exp(gamma)

  se_psi <-
    fit$psi *
    se_gamma


  se_log_phi <-
    se_transf[
      p +
      n_psi +
      1
    ]


  se_phi <-
    fit$phi *
    se_log_phi


  list(

    H =
      H,

    V =
      V,

    se_beta =
      se_beta,

    se_psi =
      se_psi,

    se_phi =
      se_phi

  )
}
