# 20. Decomposição da previsão SP-NB

A previsão pode ser decomposta em:

\[
\lambda_{g,t}
=
\lambda^{clima}_{g,t}
+
\lambda^{espacial}_{g,t}.
\]

```{r decomposicao}
# ============================================================
# 20. DECOMPOSICAO
# ============================================================

calcular_componentes <- function(
    dados,
    X,
    beta,
    psi,
    tipo,
    grid_idx
) {

  eta <-
    as.numeric(
      X %*% beta
    )

  taxa_clima <-
    exp(
      pmin(
        eta,
        30
      )
    )


  if (tipo == "global") {

    taxa_espacial <-
      psi[1] *
      dados$spatial_lag

  } else {

    taxa_espacial <-
      psi[
        grid_idx
      ] *
      dados$spatial_lag

  }


  dados %>%

    mutate(

      taxa_clima =
        taxa_clima,

      taxa_espacial =
        taxa_espacial,

      lambda_clima =
        exposicao *
        taxa_clima,

      lambda_espacial =
        exposicao *
        taxa_espacial,

      lambda_total =
        lambda_clima +
        lambda_espacial,

      pct_lambda_espacial =
        if_else(
          lambda_total > 0,
          lambda_espacial /
            lambda_total,
          0
        )

    )
}


