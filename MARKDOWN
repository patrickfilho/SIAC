# 5. Construção do componente \(A\bar{Y}_{t-1}\)

A variável abaixo representa, para cada grade e mês:

\[
S_{g,t}
=
(A\bar Y_{t-1})_g.
\]

Como \(A\) é binária e Rook, \(S_{g,t}\) é o **número de grids vizinhos que tiveram shock no mês anterior**.

```{r spatial-lag}
# ============================================================
# 5. JUNTAR Y_BAR A BASE
# ============================================================

base <- base %>%

  left_join(

    ybar %>%
      dplyr::select(
        id_celula,
        ano,
        mes,
        y_bar
      ),

    by = c(
      "id_celula",
      "ano",
      "mes"
    )

  )


if (any(is.na(base$y_bar))) {
  stop("Existem observacoes sem y_bar apos o join.")
}


# ------------------------------------------------------------
# Criar identificador temporal
# ------------------------------------------------------------

base <- base %>%

  mutate(

    data_mes =
      as.Date(
        sprintf(
          "%04d-%02d-01",
          ano,
          mes
        )
      )

  )


# ------------------------------------------------------------
# Funcao para calcular A %*% Y_bar(t-1)
# ------------------------------------------------------------

calcular_spatial_lag <- function(
    dados,
    A,
    grid_order
) {

  dados$spatial_lag <- 0

  meses <- sort(
    unique(
      dados$data_mes
    )
  )

  # Primeiro mes nao possui t-1 dentro da amostra.
  # Portanto spatial_lag = 0.

  if (length(meses) <= 1) {
    return(dados)
  }

  for (k in 2:length(meses)) {

    mes_atual <- meses[k]
    mes_anterior <- meses[k - 1]

    anterior <- dados %>%

      filter(
        data_mes == mes_anterior
      ) %>%

      select(
        id_celula,
        y_bar
      )


    vetor_ybar <- rep(
      0,
      length(grid_order)
    )

    names(vetor_ybar) <- grid_order


    vetor_ybar[
      anterior$id_celula
    ] <- anterior$y_bar


    # Multiplicacao matricial

    vetor_spatial <-
      as.numeric(
        A %*% vetor_ybar
      )

    names(vetor_spatial) <-
      grid_order


    idx <- which(
      dados$data_mes == mes_atual
    )

    dados$spatial_lag[idx] <-
      vetor_spatial[
        dados$id_celula[idx]
      ]

  }

  dados
}


base <- calcular_spatial_lag(
  dados = base,
  A = A,
  grid_order = grid_order
)


# ------------------------------------------------------------
# Validacao
# ------------------------------------------------------------

cat(
  "Distribuicao de A %*% Y_bar(t-1):\n"
)

print(
  table(
    base$spatial_lag
  )
)
```

