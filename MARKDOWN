# 16. Métricas de avaliação

```{r funcoes-metricas}
# ============================================================
# 16. METRICAS
# ============================================================


roc_auc_manual <- function(
    y_bin,
    prob
) {

  n1 <- sum(
    y_bin == 1
  )

  n0 <- sum(
    y_bin == 0
  )

  if (
    n1 == 0 ||
    n0 == 0
  ) {

    return(
      NA_real_
    )
  }

  ranks <- rank(
    prob,
    ties.method = "average"
  )

  (
    sum(
      ranks[
        y_bin == 1
      ]
    ) -
      n1 *
      (
        n1 + 1
      ) /
      2
  ) /
    (
      n1 *
      n0
    )
}


average_precision <- function(
    y_bin,
    prob
) {

  n_pos <- sum(
    y_bin == 1
  )

  if (n_pos == 0) {
    return(NA_real_)
  }

  ord <- order(
    prob,
    decreasing = TRUE
  )

  y_ord <-
    y_bin[
      ord
    ]

  precision <-
    cumsum(
      y_ord
    ) /
    seq_along(
      y_ord
    )

  mean(
    precision[
      y_ord == 1
    ]
  )
}


calcular_metricas <- function(
    y,
    mu,
    phi,
    k
) {

  ll <- loglik_nb(
    y,
    mu,
    phi
  )


  prob_evento <-
    1 -
    dnbinom(
      0,
      mu = mu,
      size = phi
    )


  y_bin <-
    as.integer(
      y > 0
    )


  tibble(

    N =
      length(y),

    Eventos =
      sum(y),

    LogLik =
      ll,

    Menos2LogLik =
      -2 * ll,

    AIC =
      -2 * ll +
      2 * k,

    BIC =
      -2 * ll +
      log(length(y)) *
      k,

    Balance_R =
      sum(mu) /
      sum(y),

    MAE =
      mean(
        abs(
          y - mu
        )
      ),

    RMSE =
      sqrt(
        mean(
          (
            y - mu
          )^2
        )
      ),

    LogScore_medio =
      mean(
        dnbinom(
          y,
          mu = mu,
          size = phi,
          log = TRUE
        )
      ),

    Brier =
      mean(
        (
          y_bin -
            prob_evento
        )^2
      ),

    ROC_AUC =
      roc_auc_manual(
        y_bin,
        prob_evento
      ),

    PR_AUC_AP =
      average_precision(
        y_bin,
        prob_evento
      )

  )
}
