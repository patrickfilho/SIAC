# 8. Padronização das covariáveis

A padronização é calculada **somente no conjunto de treino**.

```{r padronizacao}
# ============================================================
# 8. ESCALA DOS X
# ============================================================

x_vars <- c(
  "prec_mensal_soma",
  "prec_mensal_max",
  "dias_acima_threshold"
)


medias_x <- sapply(
  base[
    base$amostra == "Treino",
    x_vars
  ],
  mean,
  na.rm = TRUE
)


sds_x <- sapply(
  base[
    base$amostra == "Treino",
    x_vars
  ],
  sd,
  na.rm = TRUE
)


base <- base %>%

  mutate(

    X1 =
      (
        prec_mensal_soma -
        medias_x["prec_mensal_soma"]
      ) /
      sds_x["prec_mensal_soma"],

    X2 =
      (
        prec_mensal_max -
        medias_x["prec_mensal_max"]
      ) /
      sds_x["prec_mensal_max"],

    X3 =
      (
        dias_acima_threshold -
        medias_x["dias_acima_threshold"]
      ) /
      sds_x["dias_acima_threshold"]

  )


treino <- base %>%
  filter(amostra == "Treino")

teste <- base %>%
  filter(amostra == "Teste")


