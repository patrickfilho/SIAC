# 10. Funções auxiliares do SP-NB

```{r funcoes-spnb}
# ============================================================
# 10. FUNCOES DO SP-NB
# ============================================================


# ------------------------------------------------------------
# Calcular lambda
# ------------------------------------------------------------

calcular_mu_spnb <- function(
    beta,
    gamma_psi,
    X,
    E,
    S,
    grid_idx,
    tipo = c(
      "global",
      "grid"
    )
) {

  tipo <- match.arg(tipo)

  eta <- as.numeric(
    X %*% beta
  )

  taxa_base <- exp(
    pmin(
      eta,
      30
    )
  )


  if (tipo == "global") {

    psi <- exp(
      gamma_psi[1]
    )

    taxa_spatial <-
      psi *
      S

  } else {

    psi <- exp(
      gamma_psi
    )

    taxa_spatial <-
      psi[
        grid_idx
      ] *
      S

  }


  mu <-
    E *
    (
      taxa_base +
      taxa_spatial
    )


  pmax(
    mu,
    EPS
  )
}


# ------------------------------------------------------------
# Log-likelihood marginal NB
# ------------------------------------------------------------

loglik_nb <- function(
    y,
    mu,
    phi
) {

  sum(
    dnbinom(
      y,
      mu = mu,
      size = phi,
      log = TRUE
    )
  )
}


# ------------------------------------------------------------
# Algoritmo EM
# ------------------------------------------------------------

fit_spnb_em <- function(
    y,
    X,
    E,
    S,
    grid_idx,
    n_grids,
    beta_init,
    phi_init,
    tipo = c(
      "global",
      "grid"
    ),
    max_iter = 300,
    tol = 1e-6,
    verbose = TRUE
) {

  tipo <- match.arg(tipo)

  p <- ncol(X)


  # ----------------------------------------------------------
  # Inicializacao
  # ----------------------------------------------------------

  beta <- beta_init

  phi <- max(
    phi_init,
    0.01
  )


  if (tipo == "global") {

    gamma_psi <-
      log(
        0.001
      )

  } else {

    gamma_psi <- rep(
      log(0.001),
      n_grids
    )

  }


  historico <- tibble()

  ll_anterior <- -Inf


  # ==========================================================
  # EM LOOP
  # ==========================================================

  for (iter in 1:max_iter) {


    # --------------------------------------------------------
    # Lambda atual
    # --------------------------------------------------------

    mu <- calcular_mu_spnb(

      beta = beta,
      gamma_psi = gamma_psi,

      X = X,
      E = E,
      S = S,

      grid_idx = grid_idx,

      tipo = tipo

    )


    # ========================================================
    # E-STEP
    #
    # Posterior:
    #
    # Z | Y ~ Gamma(
    #   phi + Y,
    #   phi + lambda
    # )
    #
    # w1 = E[Z | Y]
    # w2 = E[log Z | Y]
    # ========================================================

    w1 <-
      (
        phi +
        y
      ) /
      (
        phi +
        mu
      )


    w2 <-
      digamma(
        phi +
        y
      ) -
      log(
        phi +
        mu
      )


    # ========================================================
    # M-STEP - BETA E PSI
    # ========================================================

    par_atual <- c(
      beta,
      gamma_psi
    )


    objetivo_media <- function(par) {

      beta_novo <-
        par[
          1:p
        ]


      gamma_novo <-
        par[
          (p + 1):
            length(par)
        ]


      mu_novo <- calcular_mu_spnb(

        beta =
          beta_novo,

        gamma_psi =
          gamma_novo,

        X = X,
        E = E,
        S = S,

        grid_idx =
          grid_idx,

        tipo =
          tipo

      )


      # Q referente a parte Poisson

      Q <-
        sum(
          y *
            log(
              mu_novo
            ) -
            w1 *
            mu_novo
        )


      -Q
    }


    # Limites para estabilidade numerica

    lower <- c(
      rep(-20, p),
      rep(
        log(1e-10),
        length(gamma_psi)
      )
    )

    upper <- c(
      rep(20, p),
      rep(
        log(100),
        length(gamma_psi)
      )
    )


    opt_media <- optim(

      par =
        par_atual,

      fn =
        objetivo_media,

      method =
        "L-BFGS-B",

      lower =
        lower,

      upper =
        upper,

      control =
        list(
          maxit = 200
        )

    )


    beta <-
      opt_media$par[
        1:p
      ]


    gamma_psi <-
      opt_media$par[
        (p + 1):
          length(
            opt_media$par
          )
      ]


    # ========================================================
    # M-STEP - PHI
    # ========================================================

    objetivo_phi <- function(
        log_phi
    ) {

      phi_novo <-
        exp(
          log_phi
        )


      # E[log g(Z; phi)]

      Q_phi <-

        length(y) *
        (
          phi_novo *
            log(phi_novo) -
            lgamma(phi_novo)
        ) +

        (
          phi_novo - 1
        ) *
        sum(w2) -

        phi_novo *
        sum(w1)


      -Q_phi
    }


    opt_phi <- optimize(

      objetivo_phi,

      interval = c(
        log(1e-4),
        log(1e5)
      )

    )


    phi <- exp(
      opt_phi$minimum
    )


    # --------------------------------------------------------
    # Nova likelihood marginal
    # --------------------------------------------------------

    mu <- calcular_mu_spnb(

      beta =
        beta,

      gamma_psi =
        gamma_psi,

      X = X,
      E = E,
      S = S,

      grid_idx =
        grid_idx,

      tipo =
        tipo

    )


    ll <- loglik_nb(
      y = y,
      mu = mu,
      phi = phi
    )


    delta_ll <-
      abs(
        ll -
        ll_anterior
      )


    historico <- bind_rows(

      historico,

      tibble(

        iteracao =
          iter,

        logLik =
          ll,

        delta_logLik =
          delta_ll,

        phi =
          phi

      )

    )


    if (
      verbose &&
      (
        iter == 1 ||
        iter %% 10 == 0
      )
    ) {

      cat(

        "Iteracao:",
        iter,

        "| logLik:",
        round(ll, 4),

        "| delta:",
        round(delta_ll, 8),

        "| phi:",
        round(phi, 4),

        "\n"

      )

    }


    # --------------------------------------------------------
    # Convergencia
    # --------------------------------------------------------

    if (
      iter > 1 &&
      delta_ll < tol
    ) {

      if (verbose) {

        cat(
          "\nConvergencia atingida na iteracao",
          iter,
          "\n"
        )

      }

      break
    }


    ll_anterior <- ll

  }


  # ----------------------------------------------------------
  # Resultado
  # ----------------------------------------------------------

  psi <- exp(
    gamma_psi
  )


  list(

    beta =
      beta,

    gamma_psi =
      gamma_psi,

    psi =
      psi,

    phi =
      phi,

    mu =
      mu,

    logLik =
      ll,

    historico =
      historico,

    iteracoes =
      iter,

    convergiu =
      (
        iter < max_iter
      ),

    tipo =
      tipo

  )
}
```

