# 9. Construção de \(\bar Y\)

A frequência global é:

\[
\lambda_G
=
\frac{\sum Y}{\sum E}.
\]

Para evitar vazamento de informação para a avaliação fora da amostra, \(\lambda_G\) é calculado usando apenas o período de treinamento.

```{r ybar}
# ============================================================
# 9. Y_BAR
# ============================================================

grid_mes <- grid_mes %>%

  dplyr::mutate(

    amostra =
      if_else(
        ano <= TRAIN_END_YEAR,
        "Treino",
        "Teste"
      )

  )


lambda_global <- grid_mes %>%

  dplyr::filter(
    amostra == "Treino"
  ) %>%

  dplyr::summarise(

    lambda_global =
      sum(y_agg) /
      sum(exposicao_agg)

  ) %>%

  dplyr::pull(
    lambda_global
  )


cat(
  "Frequencia global mensal:",
  lambda_global,
  "\n"
)


grid_mes <- grid_mes %>%

  dplyr::mutate(

    lambda_ref =
      lambda_global *
      exposicao_agg,

    threshold_ybar =
      qpois(
        0.80,
        lambda =
          lambda_ref
      ),

    y_bar =
      as.integer(
        y_agg >
          threshold_ybar
      )

  )


cat(
  "\nDistribuicao do threshold Y_bar:\n"
)

print(
  table(
    grid_mes$threshold_ybar
  )
)


cat(
  "\nDistribuicao de Y_bar:\n"
)

print(
  table(
    grid_mes$y_bar
  )
)
```

# 10. Função para calcular \(A\bar Y_{t-1}\)

```{r funcao-spatial-lag}
# ============================================================
# 10. FUNCAO DE SPATIAL LAG
# ============================================================

calcular_spatial_lag <- function(
    grid_mes,
    A,
    grid_order
) {

  resultado <- grid_mes

  resultado$spatial_lag <- 0


  meses <- sort(
    unique(
      resultado$data_mes
    )
  )


  for (
    k in seq_along(meses)
  ) {


    # Primeiro mes nao possui mes anterior

    if (k == 1) {

      next

    }


    mes_atual <-
      meses[k]

    mes_anterior <-
      meses[k - 1]


    anterior <- resultado %>%

      dplyr::filter(
        data_mes ==
          mes_anterior
      )


    vetor_ybar <- rep(
      0,
      length(grid_order)
    )

    names(vetor_ybar) <-
      grid_order


    vetor_ybar[
      anterior$id_celula
    ] <-
      anterior$y_bar


    # --------------------------------------------------------
    # A %*% Y_bar(t-1)
    # --------------------------------------------------------

    S <-
      as.numeric(
        A %*%
          vetor_ybar
      )


    names(S) <-
      grid_order


    idx <-
      which(
        resultado$data_mes ==
          mes_atual
      )


    resultado$spatial_lag[
      idx
    ] <-
      S[
        resultado$id_celula[
          idx
        ]
      ]

  }


  resultado
}
```

