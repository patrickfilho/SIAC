# 5. Matriz de adjacência Rook

Na adjacência Rook, duas células são vizinhas se compartilham uma aresta.

```{r rook}
# ============================================================
# 5. MATRIZ ROOK
# ============================================================

A_rook <- matrix(

  0,

  nrow = G,
  ncol = G

)


for (i in seq_len(G)) {

  for (j in seq_len(G)) {

    if (i != j) {

      delta_linha <-
        abs(
          grids$linha[i] -
            grids$linha[j]
        )

      delta_coluna <-
        abs(
          grids$coluna[i] -
            grids$coluna[j]
        )


      if (
        delta_linha +
          delta_coluna ==
          1
      ) {

        A_rook[i, j] <- 1

      }

    }

  }

}


rownames(A_rook) <- grid_order
colnames(A_rook) <- grid_order


# ------------------------------------------------------------
# Validacoes
