        Beta_true,

      erro_Rook =
        SP_NB_Rook -
        Beta_true,

      erro_Queen =
        SP_NB_Queen -
        Beta_true,

      abs_erro_NB =
        abs(
          erro_NB
        ),

      abs_erro_Rook =
        abs(
          erro_Rook
        ),

      abs_erro_Queen =
        abs(
          erro_Queen
        )

    )


  knitr::kable(

    erro_beta %>%

      dplyr::select(

        Variavel,
        Beta_true,

        NB,
        SP_NB_Rook,
        SP_NB_Queen,

        abs_erro_NB,
        abs_erro_Rook,
        abs_erro_Queen

      ),

    digits = 5,

    caption =
      "Erro absoluto na recuperação dos betas verdadeiros"

  )

}
