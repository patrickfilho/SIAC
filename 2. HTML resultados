# 22. Funções de métricas

```{r metricas-funcao}
# ============================================================
# 22. METRICAS
# ============================================================

calcular_metricas <- function(
    y,
    mu,
    phi,
    k
) {


  ll <-
    loglik_nb(
      y =
        y,
      mu =
        mu,
      phi =
        phi
    )


  prob_evento <-

    1 -

    dnbinom(

      0,

      mu =
        mu,

      size =
        phi

    )


  y_bin <-
    as.integer(
      y > 0
    )


  tibble::tibble(

    N =
      length(y),

    Sinistros_observados =
      sum(y),

    Sinistros_previstos =
      sum(mu),

    Balance_R =
      sum(mu) /
      sum(y),

    LogLik =
      ll,

    Menos2LogLik =
      -2 *
      ll,

    AIC =
      -2 *
      ll +
      2 *
      k,

    BIC =
      -2 *
      ll +
      log(
        length(y)
      ) *
      k,

    MAE =
      mean(
        abs(
          y -
            mu
        )
      ),

    RMSE =
      sqrt(

        mean(

          (
            y -
              mu
          )^2

        )

      ),

    LogScore_medio =
      mean(

        dnbinom(

          y,

          mu =
            mu,

          size =
            phi,

          log =
            TRUE

        )

      ),

    Brier =
      mean(

        (
          y_bin -
            prob_evento
        )^2

      )

  )

}
```

